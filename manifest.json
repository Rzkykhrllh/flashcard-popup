{
  "manifest_version": 3,
  "name": "Nihongo Popup — Kotoba Bank",
  "version": "0.1.0",
  "description": "Japanese flashcards that pop up while you browse — plus a vocab bank, kanji graph, and dictionary to organize everything you learn.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Nihongo Popup — Kotoba Bank",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "pages/options.html",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://docs.google.com/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core/kanji.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["core/reader-match.js", "reader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/kanjidic.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
